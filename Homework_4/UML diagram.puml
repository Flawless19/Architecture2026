@startuml
!theme plain

entity "products" as products {
    * id
    --
    name
    description
    category_id
    seller_id
    price
    status
}

entity "orders" as orders {
    * id
    --
    user_id
    seller_id
    status
    created_at
    total_amount
}

products ||--o{ orders : "seller_id"
@enduml